<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UDP 触发程序（原版「UDP触发程序」+「UDP端口设置」）：一个很小的原生程序，
    把自己的文件名（不含扩展名）作为指令发给 QuellGTA 的 UDP 端口，然后退出。
    复制一份改名为 kill.exe 就是「杀掉进程」，fwon.exe 就是「阻止联网」……
    用 Native AOT 发布，不需要安装 .NET 运行时，启动只要几十毫秒。由「UDP 触发程序」插件生成和分发。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QuellUdpTrigger</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <Version>1.0.0</Version>
    <Copyright>GPL-3.0</Copyright>
  </PropertyGroup>

</Project>
