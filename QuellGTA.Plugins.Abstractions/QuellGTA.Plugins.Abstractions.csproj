<Project Sdk="Microsoft.NET.Sdk">

  <!--
    QuellGTA 插件接口。主程序和每个插件都引用这个程序集；运行时只有主程序目录里的这一份会被加载，
    插件的输出目录里不要带它（插件项目引用时设 Private=false）。
    接口只增不改：改了已有成员就要提高 PluginApi.Version，旧插件会被拒绝加载。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>QuellGTA.Plugins</RootNamespace>
    <AssemblyName>QuellGTA.Plugins.Abstractions</AssemblyName>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.0.0</Version>
    <Authors>MageAngela</Authors>
    <Copyright>GPL-3.0</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260114001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
  </ItemGroup>

</Project>
