<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>QuellGTA</RootNamespace>
    <AssemblyName>QuellGTA</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 入口在 Program.cs：带 guard 参数时只当守护进程，不加载界面 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- 非打包（unpackaged）桌面程序，自带 Windows App SDK 运行时，解压即用 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <Version>4.22.216</Version>
    <Authors>MageAngela</Authors>
    <Product>QuellGTA</Product>
    <Description>QuellGTA 在必要时快速断网（WinUI 3 移植版）</Description>
    <Copyright>www.MageAngela.cn · GPL-3.0</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260114001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <!-- 浮窗（准星 / 计时）用 GDI+ 绘制带透明度的位图 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- 虚拟手柄（后台挂机 / 手柄偷速），需要用户另外安装 ViGEmBus 驱动 -->
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <!-- 设置卡（SettingsCard / SettingsExpander），Windows 设置和 PowerToys 用的同一套控件，MIT 许可 -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件接口：主程序和插件共用这一份 -->
    <ProjectReference Include="..\QuellGTA.Plugins.Abstractions\QuellGTA.Plugins.Abstractions.csproj" />
    <!-- 随程序发布的插件：只保证先编译（不引用它们的程序集），编译完复制到输出目录的 Plugins\<程序集名>\ -->
    <PluginProject Include="..\QuellGTA.Plugins\*\*.csproj" />
    <ProjectReference Include="@(PluginProject)" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="CopyBundledPlugins" AfterTargets="Build">
    <MSBuild Projects="@(PluginProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_PluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <!-- 插件输出目录里的全部文件（插件接口、WinUI 这些主程序已有的程序集不会被复制到那里） -->
      <_PluginFile Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)**\*" Exclude="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)**\*.deps.json"
                   PluginName="%(_PluginAssembly.Filename)" PluginDir="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)" />
      <!-- 主程序目录里已有的文件（WinUI 带进来的 WebView2 等）运行时用主程序那一份，不重复复制 -->
      <_PluginFile Remove="@(_PluginFile)" Condition="'%(RecursiveDir)' == '' and Exists('$(OutDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFile)" DestinationFiles="@(_PluginFile->'$(OutDir)Plugins\%(PluginName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishBundledPlugins" AfterTargets="Publish">
    <ItemGroup>
      <_PublishPluginFile Include="$(OutDir)Plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishPluginFile)" DestinationFiles="@(_PublishPluginFile->'$(PublishDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- GPL-3.0 要求分发时附带许可证全文：随程序一起输出 -->
    <Content Include="..\LICENSE" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
