<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuellGTA.Views.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuellGTA.Views">

    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="920" />
            </Grid.ColumnDefinitions>
        <StackPanel Margin="28,20,28,28">
            <TextBlock Text="战局" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="得到单人公开战局、锁住自己的战局、断网后悬停在保存失败的提示上。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <!-- 战局卡单 -->
            <TextBlock Text="战局卡单" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                <StackPanel Spacing="4">
                    <TextBlock Text="卡单模式" />
                    <TextBlock Text="让游戏短暂失去响应，其他玩家因超时离开，从而得到单人公开战局。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButtons x:Name="ModeRadios" SelectionChanged="Mode_SelectionChanged" Margin="0,6,0,0">
                        <RadioButton Content="暂停进程 — 兼容性最好，推荐" />
                        <RadioButton Content="挂起窗口 — 适合传承版" />
                        <RadioButton Content="右键菜单 — 适合增强版，需要游戏在前台" />
                        <RadioButton Content="阻止 P2P 端口（6672）— 不暂停游戏，用防火墙隔离其他玩家" />
                        <RadioButton Content="关闭该功能" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <local:SettingRow Title="卡单时长（秒）" Description="到时间后自动结束。卡单过程中再按一次卡单键可立即结束。">
                <NumberBox x:Name="DurationBox" Minimum="1" Maximum="60" SmallChange="1" LargeChange="5"
                           SpinButtonPlacementMode="Compact" Width="140" ValueChanged="Duration_Changed" />
            </local:SettingRow>

            <local:SettingRow Title="安全间隔（毫秒）" Description="两次卡单操作之间的最短间隔，防止连按。">
                <NumberBox x:Name="IntervalBox" Minimum="100" Maximum="10000" SmallChange="100" LargeChange="500"
                           SpinButtonPlacementMode="Compact" Width="140" ValueChanged="Interval_Changed" />
            </local:SettingRow>

            <!-- 战局锁 -->
            <TextBlock Text="战局锁" Style="{StaticResource SectionHeaderStyle}" />

            <InfoBar x:Name="LockInfo" IsOpen="True" IsClosable="False" Margin="0,0,0,4" />

            <local:SettingRow Title="战局密码"
                              Description="只有使用相同密码的玩家才会匹配到同一个战局。创建或删除后都要重启游戏才生效。">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="PasswordBox" IsEditable="True" Width="200" PlaceholderText="输入密码" />
                    <Button x:Name="LockButton" Content="上锁" Style="{StaticResource AccentButtonStyle}" Click="Lock_Click" />
                    <Button x:Name="UnlockButton" Content="解锁" Click="Unlock_Click" />
                </StackPanel>
            </local:SettingRow>

            <local:SettingRow Title="游戏位置" x:Name="GameDirRow">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="刷新状态" Click="RefreshLock_Click" />
                    <Button Content="清空记住的密码" Click="ClearPasswords_Click" />
                </StackPanel>
            </local:SettingRow>

            <!-- 瞬间悬停 -->
            <TextBlock Text="瞬间悬停" Style="{StaticResource SectionHeaderStyle}" />

            <local:SettingRow Title="悬停方式"
                              Description="Alt+F4 方式：临时阻断游戏联网 → 向游戏发送关闭 → 按 Esc 取消退出。保存请求发不出去，游戏会停在保存失败的状态上。">
                <ComboBox x:Name="HoverCombo" Width="200" SelectionChanged="Hover_SelectionChanged">
                    <ComboBoxItem Content="关闭该功能" />
                    <ComboBoxItem Content="Alt+F4 阻云悬停（只断 TCP）" />
                    <ComboBoxItem Content="Alt+F4 断网悬停（全部断开）" />
                    <ComboBoxItem Content="切换角色悬停" />
                </ComboBox>
            </local:SettingRow>

            <local:SettingRow x:Name="SwitchKeyRow" Title="切换角色键"
                              Description="切换角色悬停：按住悬停键时替你按住这个键，松开悬停键时松开它并按 Esc。填游戏里「切换到某个故事模式角色」的按键，默认 F6。">
                <Button x:Name="SwitchKeyButton" MinWidth="120" Click="SwitchKey_Click" />
            </local:SettingRow>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
