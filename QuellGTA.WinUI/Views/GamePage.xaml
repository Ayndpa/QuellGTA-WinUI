<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuellGTA.Views.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuellGTA.Views">

    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="920" />
            </Grid.ColumnDefinitions>
        <StackPanel Margin="28,20,28,28">
            <TextBlock Text="游戏" Style="{StaticResource PageTitleStyle}" />

            <!-- 启动 -->
            <TextBlock Text="启动游戏" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Steam 增强版" Tag="SteamEnhanced" Click="Launch_Click" />
                    <Button Content="Epic 增强版" Tag="EpicEnhanced" Click="Launch_Click" />
                    <Button Content="Steam 传承版" Tag="SteamLegacy" Click="Launch_Click" />
                    <Button Content="Epic 传承版" Tag="EpicLegacy" Click="Launch_Click" />
                </StackPanel>
            </Border>

            <!-- 版本 -->
            <TextBlock Text="本程序控制哪个版本" Style="{StaticResource SectionHeaderStyle}" />

            <local:SettingRow Title="自动检测" Description="哪个版本的游戏在运行，就自动切换到哪个版本。">
                <ToggleSwitch x:Name="AutoDetectSwitch" Toggled="AutoDetect_Toggled" />
            </local:SettingRow>

            <local:SettingRow x:Name="EditionRow" Title="游戏版本">
                <ComboBox x:Name="EditionCombo" Width="220" SelectionChanged="Edition_SelectionChanged">
                    <ComboBoxItem Content="GTAV 增强版" />
                    <ComboBoxItem Content="GTAV 传承版" />
                    <ComboBoxItem Content="自定义进程" />
                </ComboBox>
            </local:SettingRow>

            <local:SettingRow x:Name="CustomRow" Title="自定义进程名" Description="例如 GTA5_Enhanced.exe。按回车保存。">
                <TextBox x:Name="CustomBox" Width="220" KeyDown="Custom_KeyDown" LostFocus="Custom_LostFocus" />
            </local:SettingRow>

            <local:SettingRow Title="自动切换双版本存档" Description="传承版和增强版各用一份本程序的配置。切换游戏版本（包括自动检测切换）时换上对应版本的配置并重启本程序。使用自定义进程时不可用。">
                <ToggleSwitch x:Name="DualProfileSwitch" Toggled="DualProfile_Toggled" />
            </local:SettingRow>

            <!-- 启动选项 -->
            <TextBlock Text="启动选项" Style="{StaticResource SectionHeaderStyle}" />
            <InfoBar x:Name="ArgsInfo" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,0,0,4"
                     Title="还不知道游戏装在哪"
                     Message="启动选项写在游戏目录的 args.txt 里。请在本程序运行时启动一次游戏，之后这里就可以用了。" />
            <StackPanel x:Name="ArgsPanel" />
            <local:SettingRow x:Name="ArgsRow" Title="清空启动选项" Description="删除 args.txt（移到回收站）。">
                <Button Content="清空" Click="ClearArgs_Click" />
            </local:SettingRow>

            <!-- 画质 -->
            <TextBlock Text="画质文件调整" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock x:Name="GraphicsHint" Margin="2,0,0,6" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="GraphicsPanel" />
            <StackPanel x:Name="ExtraPanel" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
