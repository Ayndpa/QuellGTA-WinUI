<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuellGTA.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:QuellGTA.Services"
    NavigationCacheMode="Required">

    <Grid Padding="28,20,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 状态 -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse x:Name="GameDot" Width="10" Height="10" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock x:Name="GameStateText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="GameNameText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse x:Name="NetDot" Width="10" Height="10" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock x:Name="NetStateText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="NetDetailText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse x:Name="SoloDot" Width="10" Height="10" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock x:Name="SoloStateText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SoloDetailText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 主要操作 -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="KillButton" Click="Kill_Click" HorizontalAlignment="Stretch" Height="92"
                    AutomationProperties.Name="杀掉进程">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE7E8;" FontSize="22" />
                    <TextBlock Text="杀掉进程" HorizontalAlignment="Center" />
                    <TextBlock x:Name="KillKeyText" HorizontalAlignment="Center" Opacity="0.6"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>

            <Button x:Name="BlockButton" Grid.Column="1" Click="Block_Click" HorizontalAlignment="Stretch" Height="92"
                    AutomationProperties.Name="阻止联网">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE83D;" FontSize="22" />
                    <TextBlock Text="阻止联网" HorizontalAlignment="Center" />
                    <TextBlock x:Name="BlockKeyText" HorizontalAlignment="Center" Opacity="0.6"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>

            <Button x:Name="NicButton" Grid.Column="2" Click="Nic_Click" HorizontalAlignment="Stretch" Height="92"
                    AutomationProperties.Name="禁用网卡">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xEB5E;" FontSize="22" />
                    <TextBlock Text="禁用网卡" HorizontalAlignment="Center" />
                    <TextBlock x:Name="NicKeyText" HorizontalAlignment="Center" Opacity="0.6"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>

            <Button x:Name="RestoreButton" Grid.Column="3" Click="Restore_Click" HorizontalAlignment="Stretch" Height="92"
                    AutomationProperties.Name="恢复网络">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE774;" FontSize="22" />
                    <TextBlock Text="恢复网络" HorizontalAlignment="Center" />
                    <TextBlock x:Name="RestoreKeyText" HorizontalAlignment="Center" Opacity="0.6"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>

            <Button x:Name="SoloButton" Grid.Column="4" Click="Solo_Click" HorizontalAlignment="Stretch" Height="92"
                    AutomationProperties.Name="战局卡单">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE77B;" FontSize="22" />
                    <TextBlock x:Name="SoloButtonText" Text="战局卡单" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SoloKeyText" HorizontalAlignment="Center" Opacity="0.6"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 快捷入口 -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DropDownButton Content="启动游戏">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Steam 增强版" Tag="SteamEnhanced" Click="Launch_Click" />
                        <MenuFlyoutItem Text="Epic 增强版" Tag="EpicEnhanced" Click="Launch_Click" />
                        <MenuFlyoutItem Text="Steam 传承版" Tag="SteamLegacy" Click="Launch_Click" />
                        <MenuFlyoutItem Text="Epic 传承版" Tag="EpicLegacy" Click="Launch_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <ToggleButton x:Name="CrosshairToggle" Grid.Column="1" Content="外置准星" Click="Crosshair_Click" />
            <ToggleButton x:Name="AfkToggle" Grid.Column="2" Content="前台挂机" Click="Afk_Click" />
            <Button x:Name="TimerButton" Grid.Column="3" Click="Timer_Click" />
            <HyperlinkButton x:Name="LockLink" Grid.Column="5" Click="LockLink_Click" />
        </Grid>

        <!-- 日志 -->
        <Grid Grid.Row="3" Margin="2,8,0,0">
            <TextBlock Text="日志" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <HyperlinkButton Content="保存并打开" Click="SaveLog_Click" />
                <HyperlinkButton Content="清空" Click="ClearLog_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="4">
            <ListView x:Name="LogList" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Padding" Value="12,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:LogEntry">
                        <Grid ColumnSpacing="10" Opacity="{x:Bind Emphasis}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Time}" FontFamily="Consolas" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
