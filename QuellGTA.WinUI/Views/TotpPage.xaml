<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuellGTA.Views.TotpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="920" />
            </Grid.ColumnDefinitions>
        <StackPanel Margin="28,20,28,28">
            <Grid>
                <TextBlock Text="令牌" Style="{StaticResource PageTitleStyle}" />
                <Button Content="添加令牌" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="Add_Click" />
            </Grid>
            <TextBlock Text="生成 Rockstar 账号两步验证的 6 位验证码，每 30 秒更新一次，不需要联网。点击验证码即可复制。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Margin="0,12,0,0" />

            <ProgressBar x:Name="Countdown" Minimum="0" Maximum="30" Margin="0,16,0,8" />
            <StackPanel x:Name="TokenPanel" />
            <TextBlock x:Name="EmptyText" Margin="2,8,0,0" TextWrapping="Wrap"
                       Text="还没有令牌。在 Rockstar 账号的两步验证设置里选择「无法扫描二维码」，把显示的密钥粘贴进来即可。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="隐私与安全" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="密钥只保存在本机，并用 Windows 数据保护加密：只有当前登录的 Windows 用户能解开，文件拷到别的电脑上无法使用。验证码按本机时间计算，电脑时间不准会导致验证码无效。请同时保留 Rockstar 提供的备用恢复码，以免重装系统后无法登录。" />
            </Border>
            <StackPanel x:Name="ExtraPanel" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
