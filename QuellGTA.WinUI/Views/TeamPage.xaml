<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuellGTA.Views.TeamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuellGTA.Views"
    xmlns:svc="using:QuellGTA.Services">

    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="920" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="28,20,28,28">
                <TextBlock Text="联机" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="和队友连到同一个房间、设成同一个小队后，一个人杀进程、断网或卡单，其他人会同步执行。可以和原版 QuellGTA 互相连接。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <InfoBar x:Name="StateBar" IsOpen="True" IsClosable="False" Margin="0,12,0,0">
                    <InfoBar.ActionButton>
                        <Button x:Name="LeaveButton" Content="离开" Click="Leave_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- 身份 -->
                <TextBlock Text="我的身份" Style="{StaticResource SectionHeaderStyle}" />

                <local:SettingRow Title="昵称" Description="队友在日志里看到的名字，最多 8 个字母或 4 个汉字。">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="NicknameBox" Width="180" LostFocus="Nickname_LostFocus" />
                        <Button Content="自动生成" Click="GenerateNickname_Click" />
                    </StackPanel>
                </local:SettingRow>

                <local:SettingRow Title="小队口令"
                                  Description="口令相同的人才会互相同步。Public 是公开小队，可能被不认识的玩家的操作影响，建议和队友约定一个口令。">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="TeamBox" Width="180" MaxLength="8" />
                        <Button Content="应用" Click="ApplyTeam_Click" />
                        <Button Content="回到公开" Click="PublicTeam_Click" />
                    </StackPanel>
                </local:SettingRow>

                <!-- 加入 -->
                <TextBlock Text="加入房间" Style="{StaticResource SectionHeaderStyle}" />

                <local:SettingRow Title="房间地址" Description="向房主要「域名:端口」或「IP:端口」，不要带 http 前缀。">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="AddressBox" Width="260" PlaceholderText="abc.example.com:12345" />
                        <Button x:Name="JoinButton" Content="加入" Style="{StaticResource AccentButtonStyle}" Click="Join_Click" />
                    </StackPanel>
                </local:SettingRow>

                <local:SettingRow Title="公益服" Description="热心玩家捐赠的公共房间，不用自己建房。加入后记得设置小队口令。">
                    <DropDownButton x:Name="PublicButton" Content="选择公益服">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="PublicMenu" Placement="Bottom" Opening="PublicMenu_Opening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </local:SettingRow>

                <!-- 建房 -->
                <TextBlock Text="自己建房" Style="{StaticResource SectionHeaderStyle}" />

                <local:SettingRow Title="开服务器"
                                  Description="队友要能连到这台电脑：同一局域网可以直接用内网 IP；不在一起时需要端口映射或内网穿透（用 TCP 模式，不要用 HTTP）。">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="PortBox" Minimum="1" Maximum="65535" Width="120" SpinButtonPlacementMode="Hidden"
                                   ValueChanged="Port_Changed" />
                        <Button x:Name="HostButton" Content="建房" Click="Host_Click" />
                    </StackPanel>
                </local:SettingRow>

                <Border x:Name="MemberCard" Style="{StaticResource CardStyle}" Margin="0,0,0,4" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock Text="房间成员" />
                        <ListView x:Name="MemberList" SelectionMode="None" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:TeamMember">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Team}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Ping}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Version}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Address}" Opacity="0.6" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- 同步内容 -->
                <TextBlock Text="同步哪些操作" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="勾选的操作：我做的时候通知队友，队友做的时候我也跟着做。"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox x:Name="KillCheck" Content="杀掉进程" Click="Broadcast_Click" />
                            <CheckBox x:Name="BlockCheck" Content="阻止联网" Click="Broadcast_Click" />
                            <CheckBox x:Name="NicCheck" Content="禁用网卡" Click="Broadcast_Click" />
                            <CheckBox x:Name="SoloCheck" Content="战局卡单" Click="Broadcast_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 消息 -->
                <local:SettingRow Title="给小队发消息" Description="不超过 64 个字，会出现在队友的日志里。">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="MessageBox" Width="260" MaxLength="64" KeyDown="Message_KeyDown" />
                        <Button x:Name="SendButton" Content="发送" Click="Send_Click" />
                    </StackPanel>
                </local:SettingRow>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
