<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuellGTA.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuellGTA.Views">

    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="920" />
            </Grid.ColumnDefinitions>
        <StackPanel Margin="28,20,28,28">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="启动与托盘" Style="{StaticResource SectionHeaderStyle}" />

            <local:SettingRow Title="开机自动运行"
                              Description="登录 Windows 后以管理员权限自动启动，并最小化到托盘。通过计划任务实现，不会弹出权限确认。">
                <ToggleSwitch x:Name="AutoStartSwitch" Toggled="AutoStart_Toggled" />
            </local:SettingRow>

            <local:SettingRow Title="显示托盘图标" Description="右键托盘图标可以直接杀进程、断网、恢复网络。">
                <ToggleSwitch x:Name="TraySwitch" Toggled="Tray_Toggled" />
            </local:SettingRow>

            <local:SettingRow Title="关闭窗口时隐藏到托盘" Description="点关闭按钮不退出程序，热键继续有效。从托盘菜单里退出。">
                <ToggleSwitch x:Name="CloseToTraySwitch" Toggled="CloseToTray_Toggled" />
            </local:SettingRow>

            <local:SettingRow Title="启动之后最小化" Description="启动时不显示主窗口。">
                <ToggleSwitch x:Name="StartMinimizedSwitch" Toggled="StartMinimized_Toggled" />
            </local:SettingRow>

            <TextBlock Text="提示" Style="{StaticResource SectionHeaderStyle}" />

            <local:SettingRow Title="提示音音量" Description="设为 0 关闭提示音。">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" StepFrequency="5" Width="200"
                            ValueChanged="Volume_Changed" />
                    <Button Content="试听" Click="TestSound_Click" />
                </StackPanel>
            </local:SettingRow>

            <local:SettingRow Title="推送系统通知" Description="窗口隐藏时，重要的操作结果通过托盘气泡提示。">
                <ToggleSwitch x:Name="NotifySwitch" Toggled="Notify_Toggled" />
            </local:SettingRow>

            <TextBlock Text="安全" Style="{StaticResource SectionHeaderStyle}" />

            <local:SettingRow Title="启用杀掉进程" Description="关闭后，杀掉进程的按钮和热键不会真的结束游戏。">
                <ToggleSwitch x:Name="KillSwitch" Toggled="Kill_Toggled" />
            </local:SettingRow>

            <local:SettingRow Title="禁用进程路径校验"
                              Description="结束启动器时不再检查它是否真的是 Rockstar 启动器。可能误杀其他同名进程。">
                <ToggleSwitch x:Name="PathCheckSwitch" Toggled="PathCheck_Toggled" />
            </local:SettingRow>

            <TextBlock Text="数据" Style="{StaticResource SectionHeaderStyle}" />

            <local:SettingRow Title="数据目录" Description="配置文件、宏库、令牌和保存的日志都在这里。">
                <Button Content="打开数据目录" Click="OpenData_Click" />
            </local:SettingRow>
            <StackPanel x:Name="ExtraPanel" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
