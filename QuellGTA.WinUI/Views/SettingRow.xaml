<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuellGTA.Views.SettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Margin="0,0,0,4">
    <Border Style="{StaticResource CardStyle}" MinHeight="64">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TitleText" TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText" Visibility="Collapsed"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter x:Name="ActionHost" Grid.Column="1"
                              VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</UserControl>
